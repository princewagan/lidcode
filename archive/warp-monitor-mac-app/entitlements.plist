<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Outbound HTTPS to Vercel -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- App Sandbox is intentionally OFF.
         Warp's group container path is inaccessible with App Sandbox enabled.
         Without sandbox: the app inherits the user's file access, which is
         sufficient to read ~/Library/Logs/warp.log and the group container. -->
</dict>
</plist>
