# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.

# Required — generate with: openssl rand -hex 32
# Paste the same value into the Vercel dashboard (Settings → Environment Variables).
# This credential is used ONLY by the Mac app (POST /api/lidcode) to write state.
PUSH_SECRET=

# Optional: a simpler password for viewing the phone dashboard (GET /api/lidcode).
# If set, the phone page accepts this password instead of the long PUSH_SECRET.
# If unset, the phone page falls back to PUSH_SECRET for authentication.
# NEVER set this to a hardcoded value in code — supply it via the Vercel dashboard.
VIEW_PASSWORD=

# Required in production — Postgres connection string.
# Example: postgres://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=

# REMOVED: SUPABASE_URL and SUPABASE_SECRET_KEY
# The site previously used Supabase client libraries. It now talks to Postgres
# directly (lib/db.ts + lib/lidcodeStorage.ts). Those variables are dead and
# must NOT be set — they are not read anywhere.
